# Configure these as encrypted secrets in Cloudflare Pages, never in a public commit.
# ADMIN_PASSWORD: unique 18+ characters; SESSION_SECRET: random 32+ characters.
# Bind D1 as DB and a private R2 bucket as UPLOADS; neither uses an API key in source.
ADMIN_PASSWORD=SET_IN_CLOUDFLARE_DASHBOARD_NOT_HERE
SESSION_SECRET=SET_IN_CLOUDFLARE_DASHBOARD_NOT_HERE
